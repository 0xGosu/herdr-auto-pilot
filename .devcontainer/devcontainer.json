// For format details, see https://aka.ms/devcontainer.json
{
  "name": "Gelmium Development Environment in a Docker Container",
  // This is a pre-build image contain all tool required
  "image": "gelmium/devcontainer:latest",
  // Add any feature will cause devcontainer image to be rebuilt
  // "features": {
  // },
  "overrideCommand": false,
  "privileged": true,
  "mounts": [
    // Mount the herdr config and state to a volume to persist across container rebuilds
    "source=herdr-config-${devcontainerId},target=/root/.config/herdr,type=volume",
    "source=herdr-state-${devcontainerId},target=/root/.local/state/herdr,type=volume",
    // Enable docker dind
    "source=dind-var-lib-docker-${devcontainerId},target=/var/lib/docker,type=volume"
  ],
  // the run args will be passed to docker run command
  "runArgs": ["--label", "DEVCONTAINER_ID=${devcontainerId}"],

  // Use 'forwardPorts' to make a list of ports inside the container available locally.
  "forwardPorts": [],
  // Devcontainer CLI use this instead of 'forwardPorts' to expose ports.
  "appPort": [],

  // Use 'initializeCommand' to run commands in the host before the container is created.
  "initializeCommand": "docker pull gelmium/devcontainer:latest;echo DEVCONTAINER_ID=${devcontainerId} > .devcontainer/.env",

  // Use 'postCreateCommand' to run commands after the container is created.
  // scripts/devcontainer-postcreate.sh installs hap's native build deps
  // (libopenblas-dev for FAISS, cmake for scripts/setup-native.sh) and CI's
  // golangci-lint behind a toolchain-pinning wrapper; keep project setup steps
  // there, not inline.
  "postCreateCommand": "bash -i -c 'post_create_command' || true; bash scripts/devcontainer-postcreate.sh || true",

  // A command to run each time the container is successfully started.
  "postStartCommand": "bash -i -c 'post_start_command' || true",

  // Configure tool-specific properties.
  "customizations": {
    "codespaces": {
      // "repositories": {
      //   "gelmium/template-base-agentic-coding": {
      //     "permissions": "read-all"
      //   }
      // }
    },
    "vscode": {
      "extensions": [
        "ms-vscode.makefile-tools",
        "mikestead.dotenv",
        "ckolkman.vscode-postgres",
        "ms-azuretools.vscode-containers",
        "esbenp.prettier-vscode",
        "anthropic.claude-code",
        "openai.chatgpt",
        "Prisma.prisma",
        "yoavbls.pretty-ts-errors",
        "redhat.vscode-yaml",
        "ms-python.python",
        "ms-python.black-formatter",
        "ms-pyright.pyright",
        "golang.Go"
      ],
      "settings": {
        "editor.dragAndDrop": false,
        "prettier.configPath": "/root/.prettierrc",
        // ms-python.python also installs Pylance; turn it off so the Pyright extension runs
        // (Pyright disables itself when Pylance is active)
        "python.languageServer": "None"
      }
    }
  },
  "containerEnv": {
    // your environment variables
  },
  // Connect as root. To use non root user: https://aka.ms/dev-containers-non-root.
  "remoteUser": "root"
}
